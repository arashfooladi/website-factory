#!/usr/bin/env python3
"""Controlled Chromium wrapper. Only CDP pipes leave its namespaces."""
import os
import sys
import uuid

scope = 'factory_browser_' + uuid.UUID(os.environ['FACTORY_BROWSER_RUN']).hex
# Preserve Chrome's CDP pipes through programs which close descriptors > 2.
os.dup2(3, 0)
os.dup2(4, 1)
entry = ('import os,sys;os.dup2(0,3);os.dup2(1,4);os.dup2(2,1);'
         'fd=os.open("/dev/null",os.O_RDONLY);os.dup2(fd,0);'
         'os.execv("/usr/bin/chromium",["/usr/bin/chromium",*sys.argv[1:]])')
command = ['systemd-run','--user','--quiet','--scope','--unit',scope,
    '-p','MemoryMax=1536M','-p','MemorySwapMax=0','-p','TasksMax=256','-p','CPUQuota=200%','-p','RuntimeMaxSec=650',
    'bwrap','--unshare-all','--unshare-user','--disable-userns','--assert-userns-disabled',
    '--new-session','--die-with-parent','--cap-drop','ALL',
    '--ro-bind','/usr','/usr','--symlink','usr/bin','/bin','--symlink','usr/lib','/lib','--symlink','usr/lib','/lib64',
    '--proc','/proc','--dev','/dev','--size','268435456','--tmpfs','/tmp','--tmpfs','/home','--dir','/home/worker',
    '--dir','/etc','--ro-bind','/etc/fonts','/etc/fonts','--clearenv','--setenv','PATH','/usr/bin',
    '--setenv','LC_ALL','C.UTF-8','--setenv','XDG_CACHE_HOME','/tmp/cache','--','prlimit','--fsize=134217728','--core=0','--',
    '/usr/bin/python3','-c',entry,*sys.argv[1:]]
os.execvp(command[0],command)
