{
  "name": "website-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "baseline:build": "python3 tools/package_baseline.py",
    "baseline:check": "python3 tools/package_baseline.py --check && python3 tools/validate_maintheme_v4.py --php tools/php && tools/php tools/iran-helper-test.php",
    "fixture:prepare": "python3 tools/fixture.py prepare",
    "fixture:up": "python3 tools/fixture.py up",
    "fixture:seed": "python3 tools/fixture.py seed",
    "fixture:status": "python3 tools/fixture.py status",
    "fixture:down": "python3 tools/fixture.py down",
    "test": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:install": "python3 tools/check_install.py",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm run baseline:check && npm test",
    "typecheck": "tsc -p tsconfig.test.json",
    "controller:build": "tsc && node tools/copy-migrations.mjs",
    "controller:db:prepare": "python3 tools/controller_db.py prepare",
    "controller:db:up": "python3 tools/controller_db.py up",
    "controller:db:down": "python3 tools/controller_db.py down",
    "controller:db:status": "python3 tools/controller_db.py status",
    "controller:migrate": "tsx src/main.ts migrate",
    "controller:serve": "tsx src/main.ts serve",
    "controller:worker": "tsx src/main.ts worker",
    "controller:cli": "tsx src/cli.ts",
    "controller:up": "python3 tools/controller_service.py up",
    "controller:down": "python3 tools/controller_service.py down",
    "controller:status": "python3 tools/controller_service.py status",
    "test:controller": "tsx --test tests/controller/controller.test.ts",
    "test:environments": "tsx --test tests/controller/environments.test.ts",
    "test:preview": "tsx --test tests/controller/preview.test.ts",
    "test:agent-tools": "tsx --test tests/controller/agent-browser.test.ts tests/controller/agent-tools.test.ts tests/controller/provider-proxy.test.ts",
    "test:agents": "tsx --test tests/controller/agents.test.ts",
    "test:agent-capabilities": "tsx --test tests/controller/codex-capabilities.test.ts",
    "test:reference-network": "tsx --test tests/controller/reference-network.test.ts",
    "test:intakes": "tsx --test tests/controller/intakes.test.ts",
    "test:reference-agent": "tsx --test tests/controller/reference-agent.test.ts",
    "test:reference-catalog": "tsx --test tests/controller/reference-catalog.test.ts",
    "test:design": "tsx --test tests/controller/design.test.ts",
    "test:design-agent": "tsx --test tests/controller/design-agent.test.ts",
    "test:design-continuation": "tsx --test tests/controller/design-continuation.test.ts",
    "test:design-policy": "tsx --test tests/controller/design-policy.test.ts tests/controller/skills.test.ts",
    "test:themes": "tsx --test tests/controller/themes.test.ts",
    "test:design-profiles": "tsx --test tests/controller/design-profiles.test.ts",
    "test:design-profile-agent": "tsx --test tests/controller/design-profile-agent.test.ts",
    "test:build-runtime": "tsx --test tests/controller/build-runtime.test.ts",
    "test:builds": "tsx --test tests/controller/builds.test.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "zod": "4.6.7"
  }
}
